mutate(RAM=str_remove_all(`Mémoire vive (RAM)`, "Go"),RAM=as.numeric(RAM)) %>% select(-`Mémoire vive (RAM)`) %>%
mutate(stockage=str_replace_all(`Capacité totale de stockage`,"1 To","1000 Go"),
stockage=str_remove_all(stockage, "Go"),
