# Reproducibility
set.seed(123)
# Load data
data(lindner)
lindner <- lindner %>%
mutate(survival_binary = ifelse(sixMonthSurvive == FALSE, 1, 0)) %>%
select(-sixMonthSurvive, -lifepres)
Y <- lindner$survival_binary
A <- lindner$abcix
X <- lindner %>% select(-survival_binary, -abcix)
N <- nrow(lindner)
# Candidate learners
SL.library <- c("SL.mean", "SL.glm", "SL.ranger", "SL.gam","SL.eart")
# Cross-fitting folds
n_folds <- 5
fold_id <- sample(rep(1:n_folds, length.out = N))
folds   <- split(seq_len(N), fold_id)
# Candidate learners
SL.library <- c("SL.mean", "SL.glm", "SL.ranger", "SL.gam","SL.earth")
# Model formula
formula_gcomp <- as.formula(paste("Y ~ A +", paste(colnames(X), collapse = " + ")))
# Containers for cross-fitted predictions
Q1 <- numeric(N)
Q0 <- numeric(N)
for (k in 1:n_folds){
test  <- folds[[k]]
train <- setdiff(seq_len(N), test)
sl_Q <- SuperLearner(
Y          = lindner$survival_binary,
X          = lindner %>% select(-c(survival_binary,abcix)),
SL.library = SL.library,
family     = binomial(),
method     = "method.NNLS",
cvControl  = list(V = 5))
Q1[test] <- predict(sl_Q, newdata = data.frame(Y,X,A) %>% filter(A==0))$pred
Q0[test] <- predict(sl_Q, newdata = data.frame(Y,X,A) %>% filter(A==1))$pred
}
