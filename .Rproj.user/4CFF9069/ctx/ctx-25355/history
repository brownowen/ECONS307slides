library(tidyverse)
smaller <- diamonds |>
filter(carat <= 2.5)
#| label: plot-smaller-diamonds
#| echo: false
smaller |>
ggplot(aes(x = carat)) +
geom_freqpoly(binwidth = 0.01)
smaller |>
ggplot(aes(x = carat)) +
geom_freqpoly(binwidth = 0.11)
smaller |>
ggplot(aes(x = carat)) +
geom_freqpoly(binwidth = 0.1)
